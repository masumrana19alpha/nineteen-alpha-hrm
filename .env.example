NODE_ENV=production
PORT=3000

# PostgreSQL Connection
DATABASE_URL=postgresql://bms_user:change_me_strong_password@localhost:5432/nineteen_alpha_bms
DB_SSL=false
DB_POOL_MAX=15

# Authentication & Session Security
JWT_SECRET=replace_with_a_long_random_secret_key_min_32_chars
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# File & Document Vault Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Hardware / Biometric Webhook Security (Optional External Device)
BIOMETRIC_WEBHOOK_KEY=replace_with_device_webhook_secret

# Company Branding Defaults
COMPANY_NAME=Nineteen Alpha
COMPANY_LOCATION=Dhaka-1216, Bangladesh
SYSTEM_NAME=Business Management System (BMS)
